# Créer ces identifiants avant le premier démarrage (pseudo de 3 caractères minimum).
ADMIN_USERNAME=
# Au moins 10 caractères. Utiliser des guillemets simples si le mot de passe contient $ ou #.
ADMIN_PASSWORD=

# Modifier les deux lignes ensemble si le port change.
APP_PORT=8080
APP_ORIGIN=http://localhost:8080
# Passer à true lorsque l'application sera accessible en HTTPS.
COOKIE_SECURE=false
